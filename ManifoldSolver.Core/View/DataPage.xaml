<UserControl x:Class="ManifoldSolver.Core.View.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Results" FontWeight="Bold" Margin="0,0,0,5"/>

        <DataGrid x:Name="PipeData"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Runner" Binding="{Binding Name}"   Width="*"/>
                <DataGridTextColumn Header="Start"  Binding="{Binding StartP}" Width="*"/>
                <DataGridTextColumn Header="Normal" Binding="{Binding StartN}" Width="*"/>
                <DataGridTextColumn Header="End"    Binding="{Binding EndP}"   Width="50"/>
                <DataGridTextColumn Header="Normal" Binding="{Binding EndN}"   Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PreAnalyse" Content="Analyse" Width="80" Margin="0,0,5,0" 
                    Click="PreAnalyse_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
