<UserControl x:Class="ManifoldSolver.Core.View.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NumericBox" TargetType="TextBox">
            <EventSetter Event="PreviewTextInput" Handler="NumericBox_PreviewTextInput"/>
        </Style>
        <Style x:Key="IntBox" TargetType="TextBox">
            <EventSetter Event="PreviewTextInput" Handler="IntBox_PreviewTextInput"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="Solver Settings" FontWeight="Bold" Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Length (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding TargetLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pipe Diameter (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding PipeDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Bends" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource IntBox}" Margin="4,2"
                           Text="{Binding MaxBends, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Min Straight Section (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding MinStraight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Pipe Clearance (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding Clearance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Length Tolerance (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding LengthTolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Backtracks" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="6" Grid.Column="1" Style="{StaticResource IntBox}" Margin="4,2"
                           Text="{Binding MaxBacktrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Max Bend Angle (°)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="7" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding MaxAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Wall Thickness (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox   Grid.Row="8" Grid.Column="1" Style="{StaticResource NumericBox}" Margin="4,2"
                           Text="{Binding WallThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <TextBlock Text="Bend Radii" FontWeight="Bold" Margin="0,14,0,4"/>

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Value" FontSize="10" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="Mode" FontSize="10" Foreground="Gray" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Resolved" FontSize="10" Foreground="Gray" Margin="6,0,0,0"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding BendRadii}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewTextInput="RadiusValueBox_PreviewTextInput"/>
                            <ToggleButton Grid.Column="1" Margin="4,0,0,0"
                                          Content="{Binding ModeLabel}"
                                          IsChecked="{Binding IsMultiplier, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ResolvedPreview}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#666666"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}"
                                    Click="DeleteRadius_Click" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Padding="0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add Radius" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Padding="6,2" Click="AddRadius_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
